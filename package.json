{
  "name": "yoimiya-desktop-widget",
  "version": "1.1.0",
  "description": "宵宫桌面悬浮挂件 — Yoimiya Desktop Widget",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:win": "set ELECTRON_RUN_AS_NODE= && electron .",
    "dev": "electron . --dev",
    "dev:win": "set ELECTRON_RUN_AS_NODE= && electron . --dev",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:preload": "electron scripts/check-preload.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,md}\"",
    "build": "electron-builder --win portable",
    "build:dir": "electron-builder --win --dir",
    "build:green": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-green.ps1"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "build": {
    "appId": "com.yoimiya.desktop-widget",
    "productName": "YoimiyaWidget",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "store.js",
      "env.js",
      "character.js",
      "llm.js",
      "tts.js",
      "yoimiya-widget.html",
      "tray-icon.png",
      "tray-icon-32.png",
      "characters/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "portable"
    },
    "portable": {
      "artifactName": "YoimiyaWidget.exe"
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  }
}
